<article class="game-card" data-category="CATEGORY" data-name="GAME NAME">
  <div class="game-image">
    <img src="IMAGE URL" alt="GAME NAME">
  </div>

  <div class="game-info">
    <h2>GAME NAME</h2>
    <p>SHORT DESCRIPTION</p>

    <div class="game-bottom">
      <span class="category">CATEGORY</span>
      <button class="play-button" onclick="playGame('GAME NAME')">
        Play
      </button>
    </div>
  </div>
</article>
