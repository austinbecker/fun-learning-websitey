<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arcade Games</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: white;
      background: #080d1d;
    }

    header {
      padding: 25px;
      text-align: center;
      background: #111936;
    }

    header h1 {
      margin: 0 0 8px;
    }

    header p {
      color: #aab4d6;
    }

    .games {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: 35px auto;
      padding: 20px;
    }

    .game-card {
      overflow: hidden;
      border: 1px solid #29345d;
      border-radius: 10px;
      background: #111936;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.25);
    }

    .game-image {
      height: 130px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 42px;
      background: linear-gradient(135deg, #263b87, #891fc2);
    }

    .game-info {
      padding: 15px;
    }

    .game-info h2 {
      margin: 0 0 8px;
      font-size: 18px;
    }

    .game-info p {
      min-height: 40px;
      color: #aab4d6;
      font-size: 13px;
    }

    button {
      width: 100%;
      padding: 10px;
      border: 0;
      border-radius: 6px;
      color: white;
      background: #a936ff;
      cursor: pointer;
    }

    button:hover {
      background: #c166ff;
    }
  </style>
</head>

<body>
  <header>
    <h1>Arcade Games</h1>
    <p>Pick a game to start playing</p>
  </header>

  <main class="games" id="games"></main>

  <script>
    const games = [
      {
        name: "Sascha Lite",
        icon: "🔫",
        description: "Defeat enemies and survive as long as possible.",
        file: "games/sascha-lite.html"
      },
      {
        name: "Peak",
        icon: "🏔️",
        description: "Climb the mountain and reach the highest point.",
        file: "games/peak.html"
      },
      {
        name: "Turbo Drive",
        icon: "🏎️",
        description: "Drive fast and avoid traffic.",
        file: "games/turbo-drive.html"
      },
      {
        name: "Cluster Truck",
        icon: "🚚",
        description: "Jump across moving trucks without falling.",
        file: "games/cluster-truck.html"
      },
      {
        name: "Galaxy Escape",
        icon: "🚀",
        description: "Escape enemies and survive in deep space.",
        file: "games/galaxy-escape.html"
      },
      {
        name: "Battle Kingdom",
        icon: "⚔️",
        description: "Build your kingdom and defeat your opponents.",
        file: "games/battle-kingdom.html"
      }
    ];

    const gamesContainer = document.getElementById("games");

    games.forEach(game => {
      const card = document.createElement("article");

      card.className = "game-card";

      card.innerHTML = `
        <div class="game-image">${game.icon}</div>

        <div class="game-info">
          <h2>${game.name}</h2>
          <p>${game.description}</p>
          <button onclick="startGame('${game.file}')">
            Play
          </button>
        </div>
      `;

      gamesContainer.appendChild(card);
    });

    function startGame(file) {
      window.location.href = file;
    }
  </script>
</body>
</html>
